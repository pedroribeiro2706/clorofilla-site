# =============================================================================
# Clorofilla Soluções Ambientais — configuração do servidor Apache (Hostgator)
# Criado em 08/2026 durante a otimização de performance.
#
# ANTES desta configuração: 18 de 19 arquivos eram servidos sem nenhuma instrução
# de cache. Cada visita rebaixava o site inteiro do zero.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. COMPRESSÃO
# Texto (HTML, CSS, JS, SVG, JSON) comprime muito bem. Os SVGs do site estavam
# sendo servidos sem compressão nenhuma.
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 application/vnd.ms-fontobject

  # Navegadores antigos que declaram gzip mas não o implementam corretamente
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE\s7 !no-gzip !gzip-only-text/html
</IfModule>

# -----------------------------------------------------------------------------
# 2. CACHE (TTL)
# Imagens e fontes: 1 ano — são versionadas pelo nome do arquivo.
# CSS e JS: 1 mês.
# HTML: 1 hora — precisa refletir mudanças de conteúdo rapidamente.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 month"

  # Imagens — 1 ano
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"

  # Fontes — 1 ano
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType font/woff               "access plus 1 year"
  ExpiresByType font/ttf                "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # Vídeo e animação
  ExpiresByType video/webm              "access plus 1 year"
  ExpiresByType application/json        "access plus 1 month"

  # Código — 1 mês
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType text/javascript         "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"

  # HTML — 1 hora
  ExpiresByType text/html               "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # Cache longo e imutável para assets estáticos
  <FilesMatch "\.(webp|avif|jpg|jpeg|png|gif|svg|ico|woff2?|ttf|eot|webm|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Segurança básica
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Powered-By
</IfModule>

# -----------------------------------------------------------------------------
# 3. TIPOS MIME
# Servidores compartilhados antigos às vezes não conhecem WebP/AVIF e servem
# como download em vez de imagem.
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                    .webp
  AddType image/avif                    .avif
  AddType font/woff2                    .woff2
  AddType font/woff                     .woff
  AddType application/json              .json
  AddType video/webm                    .webm
</IfModule>

# -----------------------------------------------------------------------------
# 4. NÃO SERVIR ARQUIVOS DE TRABALHO
# Evita que arquivos de projeto fiquem acessíveis publicamente.
# -----------------------------------------------------------------------------
<FilesMatch "\.(psd|xmp|md|json~|bak|log)$">
  Require all denied
</FilesMatch>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# -----------------------------------------------------------------------------
# 5. COMPACTAÇÃO DE ETAGS
# ETags padrão do Apache atrapalham cache em hospedagem compartilhada.
# -----------------------------------------------------------------------------
FileETag None
